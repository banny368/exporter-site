# Copy to .env.local for local development. All are optional.

# GitHub Pages project sites are served from /<repo>. Leave empty locally.
# CI sets this automatically from the repository name.
NEXT_PUBLIC_BASE_PATH=

# Absolute origin, used for canonical URLs, sitemap entries and OG tags.
NEXT_PUBLIC_SITE_URL=

# Demo passcode for /admin. Not authentication — see README.
NEXT_PUBLIC_ADMIN_PASSCODE=demo1234

# Analytics. Nothing loads unless an ID is set AND the visitor accepts cookies.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
